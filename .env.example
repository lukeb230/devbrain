# ============================================================================
# DevBrain — environment variables
# Copy to .env.local for dev; set the same in Vercel project settings for prod.
# ============================================================================

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub App (github.com → Settings → Developer settings → GitHub Apps) --
# App slug from the app's URL, e.g. github.com/apps/<slug>
NEXT_PUBLIC_GH_APP_SLUG=
DEVBRAIN_GH_APP_ID=
# Generate in the app settings → "Generate a private key". Paste the PEM with
# literal \n for newlines (Vercel-friendly single line).
DEVBRAIN_GH_APP_PRIVATE_KEY=
# The webhook secret you set on the app.
DEVBRAIN_GH_WEBHOOK_SECRET=

# --- Agent tier (server-side Claude calls: PR reviews, digests, specs …) ----
# Without a key the deterministic units still run (traffic lights, zombies).
ANTHROPIC_API_KEY=
# (CLAUDE_API_KEY is accepted as an alias.)
# Optional model override for agent calls (default: claude-sonnet-4-5).
DEVBRAIN_AGENT_MODEL=
# Shared secret for the pg_cron → /api/agents/tick call (see supabase/cron/).
DEVBRAIN_CRON_SECRET=
# Hour (UTC, 0-23) after which the daily standup digest is written. Default 13.
DEVBRAIN_DIGEST_HOUR_UTC=
# Comma-separated tick units to skip without a deploy:
# review,automatch,spec,footprint,lights,zombie,digest,journal,index
DEVBRAIN_TICK_DISABLED=

# --- Site -------------------------------------------------------------------
# Public URL of this deployment (no trailing slash). Used by the Setup page
# to build the paste-one connect command. Falls back to the request host.
NEXT_PUBLIC_SITE_URL=

# --- Alerts -----------------------------------------------------------------
# Delivery is native (the Mac app watches alert_log over realtime). Nothing to
# set here. To receive OPERATOR alerts (tick failures, unhandled 500s, the
# Postgres watchdog) on your own Mac, name your team as the operator once:
#   insert into system_state (key, value) values ('operator', '{"org_id":"<your team uuid>"}')
#   on conflict (key) do update set value = excluded.value, updated_at = now();

# Access control is not an env var: anyone with a GitHub account can create a
# team, and teams add people with invite links (Settings → Members).

# --- Billing (Stripe) --------------------------------------------------------
# Test keys until go-live. Dashboard → Developers → API keys. Products and
# prices are created once with `node scripts/stripe-setup.mjs`; their ids
# live in system_state.stripe.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/billing/webhook` (dev)
# or the endpoint's signing secret in the dashboard (prod).
STRIPE_WEBHOOK_SECRET=
