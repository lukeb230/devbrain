{
  "identifier": "remote-panel",
  "description": "The panel and the Desk load the DevBrain web app remotely; grant them the app commands they call (notifications, setup, opening the Desk).",
  "remote": {
    "urls": [
      "https://devbrain-seven.vercel.app"
    ]
  },
  "windows": [
    "panel",
    "desk"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "allow-notify",
    "allow-notification-status",
    "allow-open-notification-settings",
    "allow-setup-state",
    "allow-bootstrap",
    "allow-run-collector-now",
    "allow-start-browser-login",
    "allow-open-external",
    "allow-open-desk",
    "allow-mac-prefs",
    "allow-set-mac-pref",
    "allow-run-update",
    "allow-toggle-panel"
  ]
}
