{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevBrain",
  "version": "0.3.8",
  "identifier": "app.devbrain.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "node/bin/node"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "devbrain"
        ]
      }
    }
  }
}
